{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pushx Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "kind", "notificationId", "subscriptionId", "bindingId", "eventKey", "expiresAt", "presentation", "payload"],
  "properties": {
    "protocolVersion": {"const": 1},
    "kind": {"enum": ["business", "test"]},
    "notificationId": {"$ref": "#/$defs/identifier"},
    "subscriptionId": {"$ref": "#/$defs/identifier"},
    "bindingId": {"$ref": "#/$defs/identifier"},
    "eventKey": {"type": "string", "minLength": 1, "maxLength": 256},
    "expiresAt": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "presentation": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "body", "sound"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 255},
        "body": {"type": "string", "maxLength": 1000},
        "sound": {"type": "boolean"}
      }
    },
    "payload": {"type": "object"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"}
  }
}
